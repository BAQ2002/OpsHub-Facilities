# Servidor Python: copie para backend/.env, se não existir.
# O caminho é resolvido a partir do código, independentemente do diretório de execução.
# Docker Compose monta backend/.env somente para leitura, sem incluí-lo na imagem.
# ORACLE_DSN deve ser acessível do container; localhost aponta para o container.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=servidor-oracle:1521/ORCLPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_CALL_TIMEOUT_MS=30000
API_DOCS_ENABLED=false
CURRENT_MEMBER_ID=1
