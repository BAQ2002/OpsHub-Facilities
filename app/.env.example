# Servidor Next.js: copie para app/.env, se ele ainda não existir.
# Se já existir, atualize somente as variáveis necessárias.
# Substitua pelo IP/DNS real do backend, acessível pelo servidor Next.js.
# Não inclua /api/v1; não use NEXT_PUBLIC_BACKEND_API_URL.
BACKEND_API_URL=http://backend.exemplo.internal:8000

# Configure antes de npm run build e mantenha no ambiente de npm start.
# Mudanças de endereço exigem novo build para atualizar os rewrites de mídia.
# Credenciais ORACLE_* pertencem somente ao servidor Python.

# Opcional, somente para desenvolvimento: hosts sem protocolo, separados por vírgula.
ALLOWED_DEV_ORIGINS=
