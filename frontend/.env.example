# Next.js e Docker Compose: copie para .env na raiz deste repositorio.
# Mesmo host Docker: backend e o nome DNS do servico na rede compartilhada.
# Hosts distintos: use o IP/DNS privado do servidor da API.
# Execucao local sem Docker: use http://127.0.0.1:8000.
# Nao inclua /api/v1 nem use NEXT_PUBLIC_BACKEND_API_URL.
# Alterar esta URL exige reconstruir a imagem (rewrites de midia).
BACKEND_API_URL=http://backend:8000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
OPSHUB_NETWORK=opshub-facilities

# Opcional, somente para desenvolvimento: hosts sem protocolo, separados por virgula.
ALLOWED_DEV_ORIGINS=
