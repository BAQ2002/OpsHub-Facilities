# Docker Compose: copie para .env na raiz deste repositorio.
# Mesmo host Docker: backend e o nome DNS do servico na rede compartilhada.
# Hosts distintos: use o IP/DNS privado do servidor da API.
# Alterar esta URL exige reconstruir a imagem (rewrites de midia).
BACKEND_API_URL=http://backend:8000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
OPSHUB_NETWORK=opshub-facilities
