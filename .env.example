# Usada exclusivamente pelo backend FastAPI.
DATABASE_URL=postgresql://opshub:opshub_dev_password@localhost:5432/opshub_facilities

# Variáveis do container Docker Compose.
POSTGRES_DB=opshub_facilities
POSTGRES_USER=opshub
POSTGRES_PASSWORD=opshub_dev_password
POSTGRES_PORT=5432

# URL interna do backend FastAPI consumida exclusivamente pelo servidor Next.js.
BACKEND_API_URL=http://127.0.0.1:8000

# Hosts adicionais que podem acessar o Next.js em desenvolvimento, separados por vírgula.
# IPs das interfaces locais são detectados automaticamente. Use esta variável para aliases
# DNS, túneis ou proxies, sempre sem o protocolo (ex.: opshub.local,opshub-dev.example.com).
ALLOWED_DEV_ORIGINS=

# ID do membro utilizado enquanto autenticação corporativa não está integrada.
CURRENT_MEMBER_ID=1
