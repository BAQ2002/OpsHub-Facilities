# Configuração do FastAPI. Nunca publique credenciais.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/ORCLPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_CALL_TIMEOUT_MS=30000
API_DOCS_ENABLED=false

# Next.js: endereço interno; configure antes do build e mantenha no runtime.
BACKEND_API_URL=http://127.0.0.1:8000

# Somente desenvolvimento: hosts explícitos, sem protocolo, separados por vírgula.
# Não altera as origens permitidas das Server Actions em produção.
ALLOWED_DEV_ORIGINS=

# Filtro de Minhas solicitações; NÃO define o solicitante de novos chamados.
CURRENT_MEMBER_ID=1
