# Runtime do repositório de dados: mock mantém os dados estáticos; postgres usa DATABASE_URL.
DATA_SOURCE=postgres

# Usada apenas no servidor (não prefixar com NEXT_PUBLIC_).
DATABASE_URL=postgresql://opshub:opshub_dev_password@localhost:5432/opshub_facilities

# Variáveis do container Docker Compose.
POSTGRES_DB=opshub_facilities
POSTGRES_USER=opshub
POSTGRES_PASSWORD=opshub_dev_password
POSTGRES_PORT=5432

# Integração opcional com FastAPI: defina DATA_SOURCE=fastapi para o Next.js buscar e enviar requests pela API.
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_REQUESTS_PATH=/activity-requests
FASTAPI_CREATE_REQUEST_PATH=/activity-requests
FASTAPI_ACTIVITIES_PATH=/activities
