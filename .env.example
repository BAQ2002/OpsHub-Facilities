# IPs das interfaces locais sÃ£o detectados automaticamente. Use esta variÃ¡vel para aliases
# DNS, tÃºneis ou proxies, sempre sem o protocolo (ex.: opshub.local,opshub-dev.example.com).
ALLOWED_DEV_ORIGINS=

# ID do membro utilizado enquanto autenticaÃ§Ã£o corporativa nÃ£o estÃ¡ integrada.
